#!/usr/bin/env bash
set -euo pipefail

# --- SSH Agent Configuration ---
TARGET_KEYS=()

# .box holds the TARGET_KEYS for this folder. Create it on first use.
if [[ ! -e .box ]]; then
    PRIVATE_KEYS=()
    for f in "$HOME"/.ssh/*; do
        if [[ -f "$f" ]] && grep -qs -- '^-----BEGIN .*PRIVATE KEY-----' "$f"; then
            PRIVATE_KEYS+=("${f##*/}")
        fi
    done

    if [[ ${#PRIVATE_KEYS[@]} -gt 0 ]]; then
        SELECTED=$(printf '%s\n' "${PRIVATE_KEYS[@]}" |
            fzf --multi --prompt='ssh keys for box> ' --header='TAB selects, ENTER confirms') || {
            echo "No keys selected, not starting box" >&2
            exit 1
        }
        {
            echo 'TARGET_KEYS=('
            while IFS= read -r name; do
                printf '    "$HOME/.ssh/%s"\n' "$name"
            done <<<"$SELECTED"
            echo ')'
        } >.box
    else
        echo "⚠️ No private keys in ~/.ssh, starting without an ssh agent" >&2
    fi
fi

if [[ -e .box ]]; then
    source ./.box
fi

SSH_AGENT_PID=""
SSH_AUTH_SOCK_HOST=""

cleanup() {
    if [[ -n "${SSH_AGENT_PID:-}" ]]; then
        kill "$SSH_AGENT_PID" 2>/dev/null || true
    fi
    # Clean up the temporary socket directory
    if [[ -n "${SOCKET_DIR:-}" && -d "$SOCKET_DIR" ]]; then
        rm -rf "$SOCKET_DIR"
    fi
}

trap cleanup EXIT

# Keys in the list that don't exist on this machine are skipped.
EXISTING_KEYS=()
for key in "${TARGET_KEYS[@]}"; do
    if [[ -f "$key" ]]; then
        EXISTING_KEYS+=("$key")
    else
        echo "⚠️ Skipping missing key $key" >&2
    fi
done

if [[ ${#EXISTING_KEYS[@]} -gt 0 && -n "${SSH_AUTH_SOCK:-}" ]]; then
    # ssh-add -l exits non-zero when the agent is empty
    HOST_AGENT_KEYS=$(ssh-add -l || true)

    for key in "${EXISTING_KEYS[@]}"; do
        # Get the precise fingerprint of the target key
        TARGET_FINGERPRINT=$(ssh-keygen -l -f "$key" | awk '{print $2}')

        # Unlock the key in your host/KDE agent first if it isn't there yet
        if ! grep -qF "$TARGET_FINGERPRINT" <<<"$HOST_AGENT_KEYS"; then
            ssh-add "$key"
        fi
    done

    # 2. Spin up the dedicated sandbox agent
    SOCKET_DIR=$(mktemp -d -t bwrap-ssh-agent.XXXXXXXX)
    SSH_AUTH_SOCK_HOST="$SOCKET_DIR/ssh-agent.sock"
    eval "$(ssh-agent -a "$SSH_AUTH_SOCK_HOST")" >/dev/null

    echo "🔄 Loading ${EXISTING_KEYS[*]} into sandbox agent..."

    # 3. Load the keys from their files into the sandbox agent. An agent never exports
    # private keys, so they can't be copied from the host agent. Only the socket
    # enters the sandbox, never the key files. ksshaskpass can get the passphrases from KWallet.
    SSH_ASKPASS="${SSH_ASKPASS:-ksshaskpass}" SSH_ASKPASS_REQUIRE=prefer \
        ssh-add "${EXISTING_KEYS[@]}" </dev/null
fi

# Export ALLOW_NET=0 to disable network access inside the sandbox.
#
# Keep in mind that if your X11/Xwayland doesn't check Xauth,
# then network access lets the sandbox connect to your X11
# via an abstract Unix socket. This is quite dangerous.
ALLOW_NET="${ALLOW_NET:-1}"

# The current folder that we're binding read-write.
REPO="$(readlink -f .)"

BWRAP=(bwrap
    --die-with-parent
    # Unshare (isolate) a bunch of things inside the sandbox.
    --unshare-pid
    --unshare-uts
    --unshare-cgroup-try
    --unshare-user-try
    --cap-drop ALL
    # Create/mount important folders.
    --proc /proc
    --dev /dev
    --tmpfs /tmp
    --tmpfs /var
    --dir /run
    --dir /etc
    --hostname sandbox

    # clear all environment variables
    --clearenv

    # Bind the current folder read-write and chdir there.
    --bind "$REPO" "$REPO"
    --chdir "$REPO"
)
# .box is sourced on the host, outside the sandbox, so the sandbox must not be able to change it.
if [[ -e "$REPO/.box" ]]; then
    BWRAP+=(--ro-bind "$REPO/.box" "$REPO/.box")
fi
# --- Expose the Isolated SSH Agent Socket ---
if [[ -n "$SSH_AUTH_SOCK_HOST" && -S "$SSH_AUTH_SOCK_HOST" ]]; then
    # Bind the socket file from the host to an identical or unique path inside /tmp
    BWRAP+=(
        --bind "$SSH_AUTH_SOCK_HOST" "/tmp/ssh-agent.sock"
        --setenv SSH_AUTH_SOCK "/tmp/ssh-agent.sock"
    )
fi

# --- Read-only system binds ---
SYS_RO_BINDS=(
    # Folders with binaries and libraries.
    /usr
    /bin
    /sbin
    /lib
    /lib64
    # Random configuration files that programs tend to need.
    /etc/alternatives
    /etc/nsswitch.conf
    /etc/man_db.conf
    /etc/hosts
    /etc/localtime
    /etc/passwd
    /etc/timezone
    /etc/pki
    /etc/ca-certificates
    /etc/ssl
    /etc/crypto-policies
    /etc/fonts
    # I fill these as I bump into problems, more or less.
    /etc/java
    /usr/lib/jvm
    /usr/share/java
)

BWRAP+=(--ro-bind-try /etc/ld.so.cache /etc/ld.so.cache)

# resolv.conf is fun because it's a symlink into /run,
# a folder which we do not want to expose.
# not the case on Void Linux, but we leave this trick in.
RESOLV_REAL="$(readlink -f /etc/resolv.conf 2>/dev/null || true)"
if [[ -n "$RESOLV_REAL" && -f "$RESOLV_REAL" ]]; then
    BWRAP+=(--ro-bind "$RESOLV_REAL" /etc/resolv.conf)
fi

# Unshare the network if needed.
if [[ "$ALLOW_NET" -eq 0 ]]; then
    BWRAP+=(--unshare-net)
fi

# Create a fresh home directory.
# The username and the path is the same as on the host
# so that everything keeps working.
BWRAP+=(--setenv HOME "$HOME"
    --dir "$HOME")

# --- Home read-only binds ---
# don't put ~/ in front!
HOME_RO_BINDS=(
    bin
    .local/bin
    .bashrc
    .bashrc.sandbox
    .config/plasma-workspace
    .local/share/claude
    .local/lib/node_modules
    .local/lib/python3.13
    .fonts
    .local/share/fonts
    .config/nvim
    .gitconfig
    .config/git
    .config/tmux
    .cache/ms-playwright
    .cache/corepack
    .bashrc
    .ssh/known_hosts
    .ssh/config
    .gitignore
    binaries/zig/
    .nvm
    calibre-bin
)

# Bind all sys binds read-only.
for p in "${SYS_RO_BINDS[@]}"; do
    [[ -e "$p" ]] && BWRAP+=(--ro-bind "$p" "$p")
done
for rel in "${HOME_RO_BINDS[@]}"; do
    [[ -e "$HOME/$rel" ]] && BWRAP+=(--ro-bind "$HOME/$rel" "$HOME/$rel")
done

# --- Home read-write binds ---
HOME_RW_BINDS=(
    .local/share/nvim
    .claude
    .claude.json
    .grok
    .cache
    .config/gh
    go
)
for rel in "${HOME_RW_BINDS[@]}"; do
    [[ -e "$HOME/$rel" ]] && BWRAP+=(--bind "$HOME/$rel" "$HOME/$rel")
done

# --- Home overlays ---
# The sandbox can write here, but the changes
# will not affect the host filesystem.
HOME_TMP_OVERLAYS=(
    .npm
)
for rel in "${HOME_TMP_OVERLAYS[@]}"; do
    [[ -d "$HOME/$rel" ]] && BWRAP+=(--overlay-src "$HOME/$rel" --tmp-overlay "$HOME/$rel")
done

# Set up $PATH with the paths that we have inside this sandbox.
BWRAP+=(--setenv PATH "$HOME/bin:$HOME/.local/bin:$HOME/binaries/zig:/usr/local/bin:/usr/bin:/bin")
BWRAP+=(--setenv COLORTERM 1)
BWRAP+=(--setenv USER "$USER")
BWRAP+=(--setenv TERM xterm-color)

if [ -d "/tmp/claude-mcp-browser-bridge-${USER}" ]; then
    BWRAP+=(--bind "/tmp/claude-mcp-browser-bridge-${USER}" "/tmp/claude-mcp-browser-bridge-${USER}")
fi

# Execute our big commandline and pass it
# the rest of the arguments (the command to run).
CMD=("${@:-bash}")
"${BWRAP[@]}" "${CMD[@]}"
