HELP_TEXT[cb]='cb [text ...]


A shortcut function that simplifies usage of xclip.
- Accepts input from either stdin (pipe), or params.
'
cb() {
    local _scs_col="\e[0;32m"
    local _wrn_col='\e[1;31m'
    local _trn_col='\e[0;33m'
    # Check that xclip is installed.
    if ! type xclip >/dev/null 2>&1; then
        echo -e "$_wrn_col""You must have the 'xclip' program installed.\e[0m"
    # Check user is not root (root doesn't have access to user xorg server)
    elif [[ "$USER" == "root" ]]; then
        echo -e "$_wrn_col""Must be regular user (not root) to copy a file to the clipboard.\e[0m"
    else
        # If no tty, data should be available on stdin
        if ! [[ "$(tty)" == /dev/* ]]; then
            input="$(</dev/stdin)"
        # Else, fetch input from params
        else
            input="$*"
        fi
        if [ -z "$input" ]; then # If no input, print usage message.
            echo "Copies a string to the clipboard."
            echo "Usage: cb <string>"
            echo "       echo <string> | cb"
        else
            # Copy input to clipboard
            echo -n "$input" | xclip -selection c
            # Truncate text for status
            if [ ${#input} -gt 80 ]; then input="$(echo $input | cut -c1-80)$_trn_col...\e[0m"; fi
            # Print status.
            echo -e "$_scs_col""Copied to clipboard:\e[0m $input"
        fi
    fi
}

HELP_TEXT[convert - dvds]='convert-dvds

Convert all .VOB files below a certain directory (as argument)'
function convert-dvds() {

    if [[ -z $1 ]]; then
        echo "Usage: $0 <dir-name>"
        return 1
    fi
    name=$(basename "$1")
    if [[ ! -d $name ]]; then
        echo "$name is not a directory"
        return 1
    fi

    set -x
    t=$(mktemp).vob
    rm -f $t
    cat "${1}"/VIDEO_TS/*.VOB >$t
    ffmpeg -i $t -c:v libx264 "${name}.mp4"
    rm $t
    set +x
}

HELP_TEXT[deb - extract]='deb-extract <deb-file>

Extract the data tarfile from a .deb file into a subdir with the base name of the deb file'
function deb-extract() {
    local debfile=$1
    if [[ ! -f $debfile ]]; then
        echo "deb-extract <deb-file>"
        return 1
    fi
    dname=${debfile%.deb}
    [[ -d $dname ]] || (
        mkdir $dname
        echo "Created $dname" >/dev/stderr
    )
    ar t $1 | grep -q data.tar.gz
    if [[ $? -eq 0 ]]; then
        ar p "$debfile" data.tar.gz | tar -C $dname -xzf -
    else
        ar t $1 | grep -q data.tar.xz
        if [[ $? -eq 0 ]]; then
            ar p "$debfile" data.tar.xz | tar -C $dname -xJf -
        else
            echo "Don't know what to do with this debian file" >/dev/stderr
        fi
    fi
    tree $dname >/dev/stderr
}

HELP_TEXT[download - site]='download-site <url> [levels]

Download a site (arg 1) with optional max number of levels'
function download-site() {
    if [[ -z $1 || $2 && ! $2 =~ ^[0-9]+ ]]; then
        echo "download-site <url> [level]"
        return 1
    fi
    if [[ $2 ]]; then
        level="--level=$2"
    else
        level=""
    fi
    wget --recursive \
        --no-clobber \
        --convert-links \
        --adjust-extension \
        --html-extension \
        -U Mozilla $level --ignore-length \
        --page-requisites \
        --restrict-file-names=ascii \
        -erobots=off $1
}

HELP_TEXT[follow - symlinks]='follow-symlinks

Follow a symlink until its non-symlink root'
function follow-symlinks() {
    file=$1
    if [[ ! -L "$file" ]]; then
        echo "use follow-symlinks <symlink>"
        return 1
    fi

    echo "Following symlink $file"
    while true; do
        #echo -n "$file"
        f=$(readlink -n $file)
        if [[ $? == 0 ]]; then
            echo "symlinks to $f"
            file=$f
        else
            echo "reached real file: $file"
            return 0
        fi
    done
}

HELP_TEXT[bash - colors]='bash-colors

