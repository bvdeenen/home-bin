HELP_TEXT[check - alphas]='check-alphas # recursively finds pngs and checks alpha treshold'
function check-alphas() {
    py=$(
        cat <<-'EOF'
        import sys
        import numpy as np
        from glob import glob
        import matplotlib.pyplot as plt

        for f in glob("**/*.png", recursive=True):
            try:
                img = plt.imread(f)
                h,w,pix = img.shape
            except Exception as e:
                print("\033[0;31m", f, e, "\033[0m")
                continue
            if pix == 4:
                alphas = img[:,:,3].flatten()
                hist = np.histogram(alphas, bins=256)[0]
                ok = hist[1:-1].sum() == 0
            else:
                ok = True
            symbol = "✓" if ok else "\u26A0"
            print(symbol, "w:", w, "h:", h, f)
EOF
    )
    python -c "$py"
}

