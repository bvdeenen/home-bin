HELP_TEXT[shrink - photos]='shrink-photos <perc.> [file ...]

Shrink photos by a percentage'
function shrink-photos() {
    local percent=$1
    if [[ "$percent" =~ ^[1-9][0-9]$ ]] && ((percent >= 10 && percent <= 99)); then
        shift
        while [ ! -z "$1" ]; do
            bak="${1%.*}_bak.${1##*.}"
            mv "$1" "$bak"
            magick "$bak" -scale ${percent}% "$1"
            shift
        done
    else
        echo "Use shrink-photos <percentage> [file ...]"
        return 1
    fi
}

HELP_TEXT[wait - for - file - to - stabilize]='wait-for-file-to-stabilize <file>

Wait for file to stop changing'
function wait-for-file-to-stabilize() {
    FILE="$1"
    if [ ! -f "$FILE" ]; then
        echo "Usage: wait-for-file-to-stabilize <file>"
        return 1
    fi

    while [ $(($(date +%s) - $(stat -c %Y "$FILE"))) -lt 10 ]; do
        sleep 1
    done
}

