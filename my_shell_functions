HELP_TEXT[json - diff]='json-diff <file1> <file2>

Show the diff between two json files

gron: https://github.com/tomnomnom/gron'
function json-diff() {
    GRON=gron
    DIFF=diff
    # colordiff: https://www.colordiff.org
    COLORDIFF=colordiff

    # use colordiff in interactive mode, diff otherwise
    if [ -t 1 ]; then
        DIFFER=${COLORDIFF}
    else
        DIFFER=${DIFF}
    fi

    LOCAL="$1"
    REMOTE="$2"
    "${DIFFER}" -u --label "a/$REMOTE" --label "b/$REMOTE" <("$GRON" <"$LOCAL") <("$GRON" <"$REMOTE") | less -R
}

