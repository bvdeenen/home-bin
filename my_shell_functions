HELP_TEXT[pdfcat]='pdfcat [-o/-O <output-file>] [input-file...]

Concatenate input pdf files into output-file (default output.pdf). Use -O to overwrite '
pdfcat() {
    local OPTIND # VERY important, won't work otherwise!!
    local OUTFILE="output.pdf"
    local OVERWRITE=0

    while getopts o:O: ARG; do
        case "$ARG" in
        o) OUTFILE="$OPTARG" ;;
        O)
            OUTFILE="$OPTARG"
            OVERWRITE=1
            ;;
        esac
    done
    shift $((OPTIND - 1))

    # If no input files were given
    if (($# == 0)); then
        echo "Error: No input PDF files provided" >&2
        return 1
    fi

    # Check all inputs exist
    for f in "$@"; do
        if [[ ! -f "$f" ]]; then
            echo "Input file not found: $f" >&2
            return 1
        fi
    done

    # Check output / overwrite logic
    if [[ $OVERWRITE -eq 0 && -f "$OUTFILE" ]]; then
        printf >&2 "Won't overwrite existing '%s'. Use -O to force overwrite.\n" "$OUTFILE"
        return 1
    fi

    local verb="Creating"
    [[ -f "$OUTFILE" ]] && verb="Overwriting"
    echo "$verb $OUTFILE ..." >&2

    # The actual merge — note the -- at the end is important
    qpdf --empty --pages "$@" -- "$OUTFILE"
}

