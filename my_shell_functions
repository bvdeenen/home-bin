HELP_TEXT[elevation]='elevation [lat, lon]

Queries open-meteo.com to get elevation. Takes value from clipboard when parameter is absent.
Parameter is comma separated lat,lon pair (like google maps)'
function elevation() {
    (
        latlon=${1:-$(xclip -o)} # parameter or clipboard
        latlon=${latlon//\"/}    # strip quotes
        IFS=', ' read lat lon <<<$latlon
        if ! isfloat "$lat"; then
            echo "lat:$lat is not a float"
            exit 1
        fi
        if ! isfloat "$lon"; then
            echo "lon:$lon is not a float"
            exit 1
        fi
        curl -s "https://api.open-meteo.com/v1/elevation?latitude=$lat&longitude=$lon" | jq -r .elevation[0]
    )
    return $?
}

