HELP_TEXT[analyze - startup]='analyze-startup

Analyze the timing of ~/.bash-startup-log'
function analyze-startup() {
    local t_old
    t_old=-1
    while read -r line; do
        read -r t what <<<$line
        if ((t_old != -1)); then
            printf "%03d ms. %s\n" $((t - t_old)) "$what"
        fi
        t_old=$t
    done <~/.bash-startup-log
}

HELP_TEXT[git - find - branches]='git-find-branches

Find all git repos below cwd that are on non-master branches'
function git-find-branches() {
    find . -type d -name .git |
        while read d; do
            cd $(dirname $d)
            branch=$(git branch --show-current)
            if [[ $branch != "master" && $branch != "main" ]]; then
                echo $PWD $branch
            fi
            cd - >/dev/null
        done

}

